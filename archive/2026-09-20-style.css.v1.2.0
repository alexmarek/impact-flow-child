/*
 Theme Name:   Impact Flow Portfolio
 Theme URI:    https://impact-flow.infinityseeker.com/
 Description:  Alex Marek's portfolio and service website, built on ImpactFlow.
 Author:       Alex Marek (Infinity Seeker)
 Author URI:   https://infinityseeker.com/
 Template:     impact-flow-theme
 Version:      1.2.0
 Text Domain:  impact-flow-portfolio
*/

/* Portfolio additions to the approved 2026-09-09 homepage design. */
.work {
	background: var(--cream);
	padding: 108px 0 115px;
}

.work .section-intro .eyebrow {
	color: var(--green);
}

.work-list {
	border-top: 1px solid var(--ink);
}

.work-item {
	display: grid;
	grid-template-columns: 72px minmax(0, 1fr) auto;
	gap: 28px;
	align-items: center;
	padding: 30px 0;
	border-bottom: 1px solid var(--line);
	color: var(--ink);
	text-decoration: none;
	transition: padding 0.2s, color 0.2s;
}

.work-item:hover {
	padding-left: 10px;
	color: var(--blue);
}

.work-number {
	font: 400 34px/1 var(--display);
	color: var(--green);
}

.work-copy {
	display: grid;
	grid-template-columns: minmax(190px, 0.55fr) minmax(260px, 1fr);
	gap: 8px 34px;
	align-items: baseline;
}

.work-copy .eyebrow {
	grid-column: 1 / -1;
	color: var(--green);
}

.work-copy strong {
	font: 400 clamp(27px, 3vw, 42px)/1.05 var(--display);
	letter-spacing: -0.04em;
}

.work-copy > span:last-child {
	color: var(--muted);
	font-size: 15px;
	max-width: 580px;
}

.work-arrow {
	font-size: 25px;
}

@media (max-width: 720px) {
	.work {
		padding: 68px 0 76px;
	}

	.work-item {
		grid-template-columns: 44px minmax(0, 1fr) auto;
		gap: 14px;
		padding: 24px 0;
	}

	.work-copy {
		grid-template-columns: 1fr;
	}
}

@media (prefers-reduced-motion: reduce) {
	html {
		scroll-behavior: auto;
	}

	*,
	*::before,
	*::after {
		scroll-behavior: auto !important;
		transition-duration: 0.01ms !important;
	}
}
